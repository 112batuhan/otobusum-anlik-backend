  "query": "\n            SELECT\n                id, stop_code AS code, name, ST_X(location) AS \"lng!\",\n                ST_Y(location) AS \"lat!\", province, city\n            FROM\n                stops\n            WHERE\n                ST_DWithin(location, ST_SetSRID(ST_MakePoint($1, $2), 4326)::geography, $3)\n        ",
