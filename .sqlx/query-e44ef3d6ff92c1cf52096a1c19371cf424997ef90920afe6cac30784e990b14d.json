  "query": "\n            SELECT\n                id, stop_code AS code, name, lng, lat, physical, province, smart, type AS stop_type, disabled_can_use, city\n             FROM\n                stops\n             WHERE\n                name ILIKE '%' || $1 || '%'\n                AND city = $2\n            LIMIT 10\n        ",
