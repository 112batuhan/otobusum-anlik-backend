  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id, stop_code, name, ST_X(location) AS \"lng\",\n                ST_Y(location) AS \"lat\", province, city\n             FROM\n                stops\n             WHERE\n                name ILIKE '%' || $1 || '%'\n                AND city = $2\n            LIMIT 10\n        ",
