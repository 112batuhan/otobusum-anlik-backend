  "query": "\n            SELECT\n                id,\n                stop_code,\n                name,\n                lng,\n                lat,\n                physical,\n                province,\n                smart,\n                type,\n                disabled_can_use,\n                city\n             FROM\n                stops\n             WHERE\n                name ILIKE '%' || $1 || '%'\n                AND city = $2\n            LIMIT 10\n        ",
