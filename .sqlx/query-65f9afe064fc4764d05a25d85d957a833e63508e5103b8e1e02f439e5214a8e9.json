{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT \n                routes.id,\n                agency_id,\n                code,\n                name as title,\n                type,\n                description,\n                routes.route_code,\n                route_paths.path as \"path!: _\" \n            FROM \n                routes\n                LEFT JOIN route_paths on route_paths.route_code = routes.route_code\n                    AND route_paths.city = $2\n            WHERE\n                code = $1\n                AND routes.city = $2\n        ",
